<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - Salesforce Mock Authenticator</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        font-family: system-ui, sans-serif;
        background: #0f0f1a;
        color: #e0e0e0;
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }

      .card {
        background: #1a1a2e;
        border: 1px solid rgba(255,80,80,0.25);
        border-radius: 12px;
        padding: 2rem;
        width: 100%;
        max-width: 480px;
      }

      h1 { color: #ff6b6b; font-size: 1.2rem; margin: 0 0 1rem; }
      p { color: rgba(255,255,255,0.7); font-size: 0.9rem; line-height: 1.6; }

      a {
        color: #00a1e0;
        font-size: 0.875rem;
        text-decoration: none;
      }

      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Authentication Error</h1>
      <p><%= message %></p>
      <a href="/">Back to home</a>
    </div>
  </body>
</html>
